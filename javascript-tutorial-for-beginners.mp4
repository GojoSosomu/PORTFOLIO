<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Gallery</title>
</head>
<body bgcolor="#f6f0f0">
    <center>
        <fieldset>
            <legend>
                <font face="Arial" size="3">
                    <b>Attack on Titan - Official Trailer</b>
